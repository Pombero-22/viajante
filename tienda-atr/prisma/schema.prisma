generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OrderStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum ShippingStatus {
  PENDING
  SHIPPED
  DELIVERED
}

model Product {
  id          String    @id @default(cuid())
  slug        String    @unique
  name        String
  description String
  price       Int // precio en centavos (ARS)
  images      String[] // URLs de imágenes
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  variants   ProductVariant[]
  orderItems OrderItem[]
  visits     Visit[]
}

model ProductVariant {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  size      String // S, M, L, XL, XXL
  color     String
  stock     Int     @default(0)

  orderItems OrderItem[]

  @@unique([productId, size, color])
}

model Order {
  id          String      @id @default(cuid())
  status      OrderStatus @default(PENDING)
  shippingStatus ShippingStatus @default(PENDING)

  buyerName    String
  buyerEmail   String
  buyerPhone   String
  shippingAddress String

  totalAmount Int // centavos

  mpPreferenceId String? @unique
  mpPaymentId    String? @unique

  items OrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])
  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id])

  quantity   Int
  unitPrice  Int // centavos, precio al momento de la compra
}

model Visit {
  id        String   @id @default(cuid())
  path      String
  referrer  String?
  source    String? // instagram, google, direct, etc. (derivado del referrer/utm)
  productId String?
  product   Product? @relation(fields: [productId], references: [id])
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([path])
}
