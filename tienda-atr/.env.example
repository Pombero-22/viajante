# Base de datos PostgreSQL
DATABASE_URL="postgresql://atr:atr@localhost:5432/atr_remeras?schema=public"

# Mercado Pago (Checkout Pro) - https://www.mercadopago.com.ar/developers/panel
MERCADOPAGO_ACCESS_TOKEN="TEST-xxxxxxxx"
NEXT_PUBLIC_MERCADOPAGO_PUBLIC_KEY="TEST-xxxxxxxx"

# URL pública del sitio (usada para armar back_urls y el webhook de MP)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Panel de administración (CRM)
ADMIN_USER="admin"
ADMIN_PASSWORD="elegí-una-contraseña-segura"
# Secreto para firmar la cookie de sesión del admin (generar con: openssl rand -base64 32)
# Importante: si el valor generado contiene el caracter '$', reemplazalo por otro
# caracter o generá uno nuevo: Next.js interpreta "$algo" como una variable de
# entorno dentro de archivos .env y puede corromper el valor.
AUTH_SECRET=""
